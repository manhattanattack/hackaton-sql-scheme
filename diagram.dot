digraph ER {
graph [rankdir=LR, bgcolor="white",pad=0.4,nodesep=0.35,ranksep=0.8,splines=polyline,
fontname="DejaVu Sans",fontsize=20,labelloc=t,label="СТАРТЕР  /  схема БД\nMySQL 8.4 · Node.js / mysql2"];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
edge [color="#94a3b8",arrowsize=0.7,fontname="DejaVu Sans",fontsize=9];
sources [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0f766e" ALIGN="LEFT"><FONT COLOR="white"><B>sources</B><BR/>Источники</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">last_success_at</TD></TR></TABLE>>];
companies [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0f766e" ALIGN="LEFT"><FONT COLOR="white"><B>companies</B><BR/>Работодатели</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK source_id</TD></TR><TR><TD ALIGN="LEFT">external_id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
vacancies [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#1d4ed8" ALIGN="LEFT"><FONT COLOR="white"><B>vacancies</B><BR/>Вакансии</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK source_id</TD></TR><TR><TD ALIGN="LEFT">external_id</TD></TR><TR><TD ALIGN="LEFT">FK company_id</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">typical_position</TD></TR><TR><TD ALIGN="LEFT">specialisation</TD></TR><TR><TD ALIGN="LEFT">region_code</TD></TR><TR><TD ALIGN="LEFT">work_format</TD></TR><TR><TD ALIGN="LEFT">schedule_type</TD></TR><TR><TD ALIGN="LEFT">salary_min</TD></TR><TR><TD ALIGN="LEFT">salary_max</TD></TR><TR><TD ALIGN="LEFT">content_hash</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#be123c" ALIGN="LEFT"><FONT COLOR="white"><B>users</B><BR/>Учётные записи</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">normalized_email</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD></TR><TR><TD ALIGN="LEFT">role</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">token_version</TD></TR></TABLE>>];
refresh_tokens [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#be123c" ALIGN="LEFT"><FONT COLOR="white"><B>refresh_tokens</B><BR/>Обновление входа</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK user_subject</TD></TR><TR><TD ALIGN="LEFT">token_hash</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD></TR><TR><TD ALIGN="LEFT">revoked_at</TD></TR></TABLE>>];
user_profiles [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#b45309" ALIGN="LEFT"><FONT COLOR="white"><B>user_profiles</B><BR/>Соискатели</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK auth_subject</TD></TR><TR><TD ALIGN="LEFT">display_name</TD></TR><TR><TD ALIGN="LEFT">city</TD></TR></TABLE>>];
skills [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7c3aed" ALIGN="LEFT"><FONT COLOR="white"><B>skills</B><BR/>Справочник навыков</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">normalized_name</TD></TR></TABLE>>];
user_skills [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7c3aed" ALIGN="LEFT"><FONT COLOR="white"><B>user_skills</B><BR/>Навыки пользователя</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK user_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK skill_id</TD></TR></TABLE>>];
vacancy_skills [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7c3aed" ALIGN="LEFT"><FONT COLOR="white"><B>vacancy_skills</B><BR/>Навыки вакансии</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK skill_id</TD></TR><TR><TD ALIGN="LEFT">is_required</TD></TR></TABLE>>];
favorites [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#475569" ALIGN="LEFT"><FONT COLOR="white"><B>favorites</B><BR/>Избранное</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK user_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
outbound_clicks [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#475569" ALIGN="LEFT"><FONT COLOR="white"><B>outbound_clicks</B><BR/>Переходы к источнику</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD></TR><TR><TD ALIGN="LEFT">FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">clicked_at</TD></TR></TABLE>>];
import_runs [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0f766e" ALIGN="LEFT"><FONT COLOR="white"><B>import_runs</B><BR/>Журнал импорта</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK source_id</TD></TR><TR><TD ALIGN="LEFT">scope_hash</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">window_from</TD></TR><TR><TD ALIGN="LEFT">window_to</TD></TR><TR><TD ALIGN="LEFT">inserted_count</TD></TR><TR><TD ALIGN="LEFT">updated_count</TD></TR></TABLE>>];
vacancy_ai_summaries [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0369a1" ALIGN="LEFT"><FONT COLOR="white"><B>vacancy_ai_summaries</B><BR/>Кеш и очередь ИИ</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">model</TD></TR><TR><TD ALIGN="LEFT">prompt_version</TD></TR><TR><TD ALIGN="LEFT">source_hash</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">lease_token</TD></TR><TR><TD ALIGN="LEFT">lease_expires_at</TD></TR><TR><TD ALIGN="LEFT">result_json</TD></TR></TABLE>>];
recommendation_runs [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0369a1" ALIGN="LEFT"><FONT COLOR="white"><B>recommendation_runs</B><BR/>Рассказ и подборка</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD></TR><TR><TD ALIGN="LEFT">prompt_text</TD></TR><TR><TD ALIGN="LEFT">parsed_profile</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
recommendation_candidates [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0369a1" ALIGN="LEFT"><FONT COLOR="white"><B>recommendation_candidates</B><BR/>SQL-кандидаты (до 50)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK run_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">position</TD></TR><TR><TD ALIGN="LEFT">source_hash</TD></TR><TR><TD ALIGN="LEFT">skill_match_percent</TD></TR></TABLE>>];
recommendation_directions [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0369a1" ALIGN="LEFT"><FONT COLOR="white"><B>recommendation_directions</B><BR/>Направления (до 5)</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK run_id</TD></TR><TR><TD ALIGN="LEFT">position</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">why_suitable</TD></TR></TABLE>>];
recommendation_direction_vacancies [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0369a1" ALIGN="LEFT"><FONT COLOR="white"><B>recommendation_direction_vacancies</B><BR/>Вакансии направлений</FONT></TD></TR><TR><TD ALIGN="LEFT">FK run_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK direction_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">position</TD></TR></TABLE>>];
sources -> companies [taillabel="1",headlabel="0..N"];
sources -> vacancies [taillabel="1",headlabel="0..N"];
sources -> import_runs [taillabel="1",headlabel="0..N"];
companies -> vacancies [taillabel="0..1",headlabel="0..N"];
users -> user_profiles [taillabel="1",headlabel="0..1"];
users -> refresh_tokens [taillabel="1",headlabel="0..N"];
user_profiles -> user_skills [taillabel="1",headlabel="0..N"];
skills -> user_skills [taillabel="1",headlabel="0..N"];
skills -> vacancy_skills [taillabel="1",headlabel="0..N"];
vacancies -> vacancy_skills [taillabel="1",headlabel="0..N"];
user_profiles -> favorites [taillabel="1",headlabel="0..N"];
vacancies -> favorites [taillabel="1",headlabel="0..N"];
user_profiles -> outbound_clicks [taillabel="1",headlabel="0..N"];
vacancies -> outbound_clicks [taillabel="1",headlabel="0..N"];
vacancies -> vacancy_ai_summaries [taillabel="1",headlabel="0..N"];
user_profiles -> recommendation_runs [taillabel="1",headlabel="0..N"];
recommendation_runs -> recommendation_candidates [taillabel="1",headlabel="0..N"];
vacancies -> recommendation_candidates [taillabel="1",headlabel="0..N"];
recommendation_runs -> recommendation_directions [taillabel="1",headlabel="0..N"];
recommendation_directions -> recommendation_direction_vacancies [taillabel="1",headlabel="0..N"];
recommendation_candidates -> recommendation_direction_vacancies [taillabel="1",headlabel="0..N"];
}