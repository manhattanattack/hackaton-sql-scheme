digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.38", ranksep="0.9", splines=polyline,
fontname="DejaVu Sans", fontsize=20, labelloc=t, label="СТАРТ В ПРОФЕССИИ  /  БД агрегатора вакансий\nMySQL 8  ·  Ключевые поля и связи"];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [color="#94a3b8", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9, fontcolor="#475569"];
sources [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#0f766e" ALIGN="LEFT"><FONT COLOR="white"><B>sources</B><BR/>Источники</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">UK code</TD></TR><TR><TD ALIGN="LEFT">name · base_url</TD></TR><TR><TD ALIGN="LEFT">access_type · is_enabled</TD></TR><TR><TD ALIGN="LEFT">last_success_at</TD></TR></TABLE>>];
companies [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#0f766e" ALIGN="LEFT"><FONT COLOR="white"><B>companies</B><BR/>Работодатели</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK source_id</TD></TR><TR><TD ALIGN="LEFT">external_id · name</TD></TR><TR><TD ALIGN="LEFT">UK (source_id, external_id)</TD></TR></TABLE>>];
vacancies [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1d4ed8" ALIGN="LEFT"><FONT COLOR="white"><B>vacancies</B><BR/>Вакансии</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK source_id · FK company_id (NULL)</TD></TR><TR><TD ALIGN="LEFT">external_id · original_url</TD></TR><TR><TD ALIGN="LEFT">title · description</TD></TR><TR><TD ALIGN="LEFT">requirements · responsibilities</TD></TR><TR><TD ALIGN="LEFT">country_code · region_name · city</TD></TR><TR><TD ALIGN="LEFT">is_remote · employment_type</TD></TR><TR><TD ALIGN="LEFT">schedule_text · schedule_mode · time_zone</TD></TR><TR><TD ALIGN="LEFT">salary_min · salary_max · currency</TD></TR><TR><TD ALIGN="LEFT">salary_period · salary_gross</TD></TR><TR><TD ALIGN="LEFT">experience_months_min · status</TD></TR><TR><TD ALIGN="LEFT">published_at · last_seen_at · raw_payload</TD></TR><TR><TD ALIGN="LEFT">UK (source_id, external_id)</TD></TR></TABLE>>];
vacancy_schedule_slots [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1d4ed8" ALIGN="LEFT"><FONT COLOR="white"><B>vacancy_schedule_slots</B><BR/>Обязательные часы работы</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id · FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">day_of_week</TD></TR><TR><TD ALIGN="LEFT">start_minute · end_minute</TD></TR></TABLE>>];
vacancy_skills [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#7c3aed" ALIGN="LEFT"><FONT COLOR="white"><B>vacancy_skills</B><BR/>Навыки вакансии</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK skill_id</TD></TR><TR><TD ALIGN="LEFT">is_required</TD></TR></TABLE>>];
skills [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#7c3aed" ALIGN="LEFT"><FONT COLOR="white"><B>skills</B><BR/>Справочник навыков</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">UK normalized_name</TD></TR></TABLE>>];
user_skills [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#7c3aed" ALIGN="LEFT"><FONT COLOR="white"><B>user_skills</B><BR/>Навыки соискателя</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK user_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK skill_id</TD></TR></TABLE>>];
user_profiles [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#b45309" ALIGN="LEFT"><FONT COLOR="white"><B>user_profiles</B><BR/>Соискатели</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">UK auth_subject</TD></TR><TR><TD ALIGN="LEFT">display_name · city · time_zone</TD></TR></TABLE>>];
user_availability [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#b45309" ALIGN="LEFT"><FONT COLOR="white"><B>user_availability</B><BR/>Свободное время</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id · FK user_id</TD></TR><TR><TD ALIGN="LEFT">day_of_week</TD></TR><TR><TD ALIGN="LEFT">start_minute · end_minute</TD></TR></TABLE>>];
favorites [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#475569" ALIGN="LEFT"><FONT COLOR="white"><B>favorites</B><BR/>Избранное</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK user_id</TD></TR><TR><TD ALIGN="LEFT">PK, FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
outbound_clicks [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#475569" ALIGN="LEFT"><FONT COLOR="white"><B>outbound_clicks</B><BR/>Переходы на исходный сайт</FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK user_id · FK vacancy_id</TD></TR><TR><TD ALIGN="LEFT">clicked_at</TD></TR><TR><TD ALIGN="LEFT">Нажатие кнопки, не отправка заявки</TD></TR></TABLE>>];
sources -> companies [taillabel="1", headlabel="0..N", labeldistance=1.6];
sources -> vacancies [taillabel="1", headlabel="0..N", labeldistance=1.6];
companies -> vacancies [taillabel="0..1", headlabel="0..N", labeldistance=1.6];
vacancies -> vacancy_schedule_slots [taillabel="1", headlabel="0..N", labeldistance=1.6];
vacancies -> vacancy_skills [taillabel="1", headlabel="0..N", labeldistance=1.6];
skills -> vacancy_skills [taillabel="1", headlabel="0..N", labeldistance=1.6];
skills -> user_skills [taillabel="1", headlabel="0..N", labeldistance=1.6];
user_profiles -> user_skills [taillabel="1", headlabel="0..N", labeldistance=1.6];
user_profiles -> user_availability [taillabel="1", headlabel="0..N", labeldistance=1.6];
user_profiles -> favorites [taillabel="1", headlabel="0..N", labeldistance=1.6];
vacancies -> favorites [taillabel="1", headlabel="0..N", labeldistance=1.6];
user_profiles -> outbound_clicks [taillabel="1", headlabel="0..N", labeldistance=1.6];
vacancies -> outbound_clicks [taillabel="1", headlabel="0..N", labeldistance=1.6];
{rank=same; sources; user_profiles; skills;}
{rank=same; companies; user_skills; user_availability;}
{rank=same; vacancies;}
{rank=same; vacancy_skills; vacancy_schedule_slots; favorites; outbound_clicks;}
legend [shape=plain, label="PK — первичный ключ   ·   FK — внешний ключ   ·   UK — уникальность\nВремя — минуты местного дня; точные типы и полный список полей — в 01_schema.sql"];
}