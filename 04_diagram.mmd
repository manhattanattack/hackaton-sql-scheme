    skills ||--o{ user_skills : "связь"
    skills ||--o{ vacancy_skills : "связь"
    vacancies ||--o{ vacancy_skills : "связь"
    user_profiles ||--o{ favorites : "связь"
    vacancies ||--o{ favorites : "связь"
    user_profiles ||--o{ outbound_clicks : "связь"
    vacancies ||--o{ outbound_clicks : "связь"
    vacancies ||--o{ vacancy_ai_summaries : "связь"
    user_profiles ||--o{ recommendation_runs : "связь"
    recommendation_runs ||--o{ recommendation_candidates : "связь"
    vacancies ||--o{ recommendation_candidates : "связь"
