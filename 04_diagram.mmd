    sources {
        bigint id PK
        varchar code
        varchar name
        datetime last_success_at
    }
    companies {
        bigint id PK
        bigint source_id FK
        varchar external_id
        varchar name
    }
    vacancies {
        bigint id PK
        bigint source_id FK
        varchar external_id
        bigint company_id FK
        varchar title
        varchar typical_position
        varchar specialisation
        varchar region_code
        enum work_format
        enum schedule_type
        decimal salary_min
        decimal salary_max
        binary content_hash
    }
    users {
        varchar id PK
        varchar normalized_email
        varchar password_hash
        enum role
        enum status
        int token_version
    }
    refresh_tokens {
        bigint id PK
        varchar user_subject FK
        binary token_hash
        datetime expires_at
        datetime revoked_at
    }
    user_profiles {
        bigint id PK
        varchar auth_subject FK
        varchar display_name
        varchar city
    }
    skills {
        bigint id PK
        varchar name
        varchar normalized_name
    }
    user_skills {
        bigint user_id PK,FK
        bigint skill_id PK,FK
    }
    vacancy_skills {
        bigint vacancy_id PK,FK
        bigint skill_id PK,FK
        boolean is_required
    }
    favorites {
        bigint user_id PK,FK
        bigint vacancy_id PK,FK
        datetime created_at
    }
    outbound_clicks {
        bigint id PK
        bigint user_id FK
        bigint vacancy_id FK
        datetime clicked_at
    }
    import_runs {
        bigint id PK
        bigint source_id FK
        binary scope_hash
        enum status
        datetime window_from
        datetime window_to
        int inserted_count
        int updated_count
    }
    vacancy_ai_summaries {
        bigint id PK
        bigint vacancy_id FK
        varchar provider
        varchar model
        varchar prompt_version
        binary source_hash
        enum status
        binary lease_token
        datetime lease_expires_at
        json result_json
    }
    recommendation_runs {
        bigint id PK
        bigint user_id FK
        text prompt_text
        json parsed_profile
        enum status
        datetime created_at
    }
    recommendation_candidates {
        bigint run_id PK,FK
        bigint vacancy_id PK,FK
        smallint position
        binary source_hash
        decimal skill_match_percent
    }
    recommendation_directions {
        bigint id PK
        bigint run_id FK
        tinyint position
        varchar title
        text why_suitable
    }
    recommendation_direction_vacancies {
        bigint run_id FK
        bigint direction_id PK,FK
        bigint vacancy_id PK,FK
        smallint position
    }
