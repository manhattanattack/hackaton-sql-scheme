erDiagram
    AspNetUsers ||--o| user_profiles : "Identity FK ON DELETE RESTRICT"
    sources ||--o{ companies : "работодатели источника"
    sources ||--o{ vacancies : "объявления источника"
    companies o|--o{ vacancies : "работодатель"
    user_profiles ||--o{ user_skills : "навыки пользователя"
    skills ||--o{ user_skills : "справочник"
    vacancies ||--o{ vacancy_skills : "навыки вакансии"
    skills ||--o{ vacancy_skills : "справочник"
    user_profiles ||--o{ user_availability : "свободное время"
    vacancies ||--o{ vacancy_schedule_slots : "обязательные часы"
    user_profiles ||--o{ favorites : "сохраняет"
    vacancies ||--o{ favorites : "в избранном"
    user_profiles ||--o{ outbound_clicks : "нажимает откликнуться"
    vacancies ||--o{ outbound_clicks : "переход на оригинал"
    user_profiles ||--o{ search_requests : "пишет промпт"
    search_requests ||--o{ search_results : "получает подборку"
    vacancies ||--o{ search_results : "реальные объявления"

    AspNetUsers {
        varchar Id PK "191 utf8mb4_bin; backend EF owns table"
        varchar NormalizedEmail UK "backend configures unique case-insensitive index"
    }

    sources {
        bigint id PK
        varchar code UK
        varchar name
        varchar base_url
        enum access_type
        boolean is_enabled
        datetime last_success_at
    }
    companies {
        bigint id PK
        bigint source_id FK "UNIQUE(source_id, external_id)"
        varchar external_id
        varchar name
        varchar original_url
    }
    vacancies {
        bigint id PK
        bigint source_id FK "UNIQUE(source_id, external_id)"
        varchar external_id
        bigint company_id FK "nullable; same source"
        varchar title
        text description
        text requirements
        text responsibilities
        varchar original_url
        char country_code
        varchar region_name
        varchar city
        boolean is_remote
        enum employment_type
        text schedule_text
        enum schedule_mode
        varchar time_zone
        decimal salary_min
        decimal salary_max
        char currency
        enum salary_period
        boolean salary_gross "nullable"
        smallint experience_months_min
        enum status
        datetime published_at
        datetime last_seen_at
        json raw_payload
    }
    user_profiles {
        bigint id PK
        varchar auth_subject UK,FK "references AspNetUsers.Id after initial FK setup"
        varchar display_name
        varchar city
        varchar time_zone
    }
    skills {
        bigint id PK
        varchar name
        varchar normalized_name UK
    }
    user_skills {
        bigint user_id PK,FK
        bigint skill_id PK,FK
    }
    vacancy_skills {
        bigint vacancy_id PK,FK
        bigint skill_id PK,FK
        boolean is_required
    }
    user_availability {
        bigint id PK
        bigint user_id FK
        tinyint day_of_week "1 Monday ... 7 Sunday"
        smallint start_minute "0..1439"
        smallint end_minute "1..1440"
    }
    vacancy_schedule_slots {
        bigint id PK
        bigint vacancy_id FK
        tinyint day_of_week
        smallint start_minute
        smallint end_minute
    }
    favorites {
        bigint user_id PK,FK
        bigint vacancy_id PK,FK
        datetime created_at
    }
    outbound_clicks {
        bigint id PK
        bigint user_id FK
        bigint vacancy_id FK
        datetime clicked_at "click, not a confirmed application"
    }
    search_requests {
        bigint id PK
        bigint user_id FK "user_profiles.id"
        text prompt_text
        json parsed_filters
        enum status "pending parsed failed"
        enum parser_kind "ai rules manual"
        varchar model_name
        varchar error_code
        datetime created_at
        datetime parsed_at
    }
    search_results {
        bigint search_request_id PK,FK
        bigint vacancy_id PK,FK
        smallint position "unique per request"
        decimal skill_match_percent "nullable; 0..100"
        text explanation
    }
